# Copy to .env and fill in. Never commit .env.

# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# OpenAI
OPENAI_API_KEY=
# AGENT_MODEL=gpt-4.1

# Google: Gmail/Drive OAuth client, Firestore
GMAIL_CREDENTIALS_PATH=client_secret.json
GCP_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json   # optional, otherwise Application Default Credentials

# Prospecting (gosom/google-maps-scraper binary)
GMAPS_SCRAPER_PATH=/path/to/google-maps-scraper
PROSPECT_MAX_CONCURRENT=2
PROSPECT_SCRAPER_CONCURRENCY=1
PROSPECT_EMAIL_WORKERS=5

# Human-like sending pace (seconds)
SEND_DELAY_MEAN=25
SEND_DELAY_STDDEV=10
SEND_DELAY_MIN=8
SEND_DELAY_MAX=60
SEND_DELAY_BREAK_CHANCE=0.05
SEND_DELAY_BREAK_MIN=60
SEND_DELAY_BREAK_MAX=120

# Pipeline
REVIEWER_MAX_ROUNDS=3
PIPELINE_MAX_WORKERS=5
RESEARCH_CACHE_TTL_DAYS=30
